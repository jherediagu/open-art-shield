{
  "name": "@openartshield/cli",
  "version": "0.1.0",
  "description": "Command-line interface for OpenArtShield: embed, extract, and audit invisible image watermarks.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jherediagu/open-art-shield.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/jherediagu/open-art-shield#readme",
  "bugs": {
    "url": "https://github.com/jherediagu/open-art-shield/issues"
  },
  "keywords": [
    "watermark",
    "cli",
    "image-protection",
    "c2pa",
    "trustmark",
    "opt-out",
