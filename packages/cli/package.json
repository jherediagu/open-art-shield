  "dependencies": {
    "@openartshield/core": "workspace:*",
    "@openartshield/node": "workspace:*",
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
