{
  "name": "@openartshield/core",
  "version": "0.1.0",
  "description": "Pure TypeScript SDK for invisible DCT watermarking, payload encoding, and robustness audit primitives.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jherediagu/open-art-shield.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jherediagu/open-art-shield#readme",
  "bugs": {
    "url": "https://github.com/jherediagu/open-art-shield/issues"
  },
  "keywords": [
    "watermark",
    "invisible-watermark",
    "dct",
    "image-protection",
    "provenance",
    "c2pa",
    "robustness",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
