{
  "name": "@openartshield/web",
  "version": "0.2.0",
  "description": "Browser bindings for OpenArtShield: ImageData/canvas IO for the pure core SDK, plus in-browser TrustMark verification. Your image never leaves the page.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jherediagu/open-art-shield.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/jherediagu/open-art-shield#readme",
  "bugs": {
    "url": "https://github.com/jherediagu/open-art-shield/issues"
  },
  "keywords": [
    "watermark",
    "browser",
    "canvas",
    "trustmark",
    "onnxruntime-web",
    "client-side",
    "verify"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "readme.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openartshield/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.19.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    }
  }
}
